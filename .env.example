# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# .env asla commit edilmez.

# --- Lokal PostgreSQL (docker-compose bu değerleri kullanır) ---
POSTGRES_USER=stajradar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stajradar
POSTGRES_PORT=5433

# Uygulamaların kullandığı bağlantı adresi
DATABASE_URL=postgresql://stajradar:change_me@localhost:5433/stajradar

# --- LLM (Aşama 6) ---
# gemini | none. Anahtar: https://aistudio.google.com/apikey
# Anahtar yoksa API yine çalışır, sadece açıklama alanı boş gelir.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
